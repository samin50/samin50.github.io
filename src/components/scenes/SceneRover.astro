---
/**
 * Showcase scene: the rover's camera. A low-resolution view of the ground
 * ahead, in the project's colour, with coloured balls lying on it; each ball
 * in turn is picked out and boxed, as the rover's vision did. The view pans
 * slowly, as if the rover were turning; the viewfinder stays put. Purely
 * decorative.
 *
 * The picture is generated here at build time on a 160 x 100 grid in seven
 * tones (the banding is the low bit depth), with each tone drawn as one path
 * of row runs, and painted once. The boxes are HTML laid over it in
 * percentages, so the pan, the boxes and the record light only animate
 * `translate`, `scale` and `opacity`.
 */
const W = 160;
const H = 100;
const TONES = 7;

/** Smooth deterministic value noise in 0..1, on a grid of `scale` cells. */
function hash(x: number, y: number): number {
  const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
  return s - Math.floor(s);
}
function noise(x: number, y: number, scale: number): number {
  const gx = x / scale;
  const gy = y / scale;
  const x0 = Math.floor(gx);
  const y0 = Math.floor(gy);
  const fx = gx - x0;
  const fy = gy - y0;
  const sx = fx * fx * (3 - 2 * fx);
  const sy = fy * fy * (3 - 2 * fy);
  const top = hash(x0, y0) + (hash(x0 + 1, y0) - hash(x0, y0)) * sx;
  const bottom = hash(x0, y0 + 1) + (hash(x0 + 1, y0 + 1) - hash(x0, y0 + 1)) * sx;
  return top + (bottom - top) * sy;
}

const horizon = (x: number) =>
  H * (0.37 + 0.05 * Math.sin(x / 23 + 0.6) + 0.02 * Math.sin(x / 8.6 + 2));
const ridge = (x: number) => horizon(x) + H * (0.05 + 0.025 * Math.sin(x / 13 + 1.3));

const rocks = [
  { x: 20.0, y: 80.0, rx: 11.4, ry: 5.4 },
  { x: 118.6, y: 58.6, rx: 6.4, ry: 3.1 },
  { x: 141.4, y: 88.6, rx: 12.9, ry: 6.3 },
  { x: 65.7, y: 52.9, rx: 4.3, ry: 2.0 },
];

/** Balls on the ground: position and radius in cells, and colour (hue offset from the project's). */
const balls = [
  { x: 34.3, y: 64.3, r: 3.7, hue: 150 },
  { x: 58.6, y: 84.3, r: 5.7, hue: 215 },
  { x: 87.1, y: 57.1, r: 3.0, hue: 290 },
  { x: 105.7, y: 74.3, r: 4.7, hue: 150 },
  { x: 131.4, y: 64.3, r: 3.9, hue: 215 },
  { x: 14.3, y: 54.3, r: 2.7, hue: 290 },
];

/** Continuous tone at a cell, 0 (darkest) to TONES - 1. */
function tone(x: number, y: number): number {
  const h = horizon(x);
  if (y < h) return 5.6 - ((h - y) / h) * 4; // sky, lightest at the horizon
  if (y < ridge(x)) return 1.6 + noise(x, y, 6) * 0.8; // far ridge
  const depth = (y - h) / (H - h); // 0 at the horizon, 1 at the bottom
  let t = 2.3 + depth * 2.2 + (noise(x, y, 14) - 0.5) * 1.1;
  // Wheel tracks, converging on the horizon.
  for (const side of [-1, 1]) {
    const tx = W / 2 + side * (3 + depth * 31);
    if (Math.abs(x + 0.5 - tx) < 0.6 + depth * 2.3) t -= 1.3;
  }
  for (const rock of rocks) {
    const d = ((x + 0.5 - rock.x) / rock.rx) ** 2 + ((y + 0.5 - rock.y) / rock.ry) ** 2;
    if (d < 1) t = y + 0.5 < rock.y - rock.ry * 0.25 && x < rock.x + rock.rx * 0.3 ? 3.4 : 0.6;
    else if (d < 1.7 && y > rock.y) t -= 1.2; // shadow
  }
  return t;
}

function cell(x: number, y: number): string {
  for (const [i, ball] of balls.entries()) {
    const d = Math.hypot(x + 0.5 - ball.x, y + 0.5 - ball.y);
    if (d < ball.r) {
      const lit = x + 0.5 < ball.x && y + 0.5 < ball.y && d > ball.r * 0.3;
      return lit ? `b${i}l` : `b${i}`;
    }
    // Each ball's shadow, below and to the right.
    if (
      Math.hypot(x + 0.5 - ball.x - ball.r * 0.4, (y + 0.5 - ball.y - ball.r * 0.75) * 1.8) < ball.r
    ) {
      return `t${Math.max(0, Math.round(tone(x, y) - 1.4))}`;
    }
  }
  return `t${Math.min(TONES - 1, Math.max(0, Math.round(tone(x, y))))}`;
}

/** One path per colour, made of row runs. */
const paths = new Map<string, string>();
for (let y = 0; y < H; y++) {
  let start = 0;
  let current = cell(0, y);
  for (let x = 1; x <= W; x++) {
    const next = x < W ? cell(x, y) : '';
    if (next !== current) {
      paths.set(current, `${paths.get(current) ?? ''}M${start} ${y}h${x - start}v1H${start}z`);
      start = x;
      current = next;
    }
  }
}
const shapes = [...paths].map(([key, d]) => {
  const ball = key.startsWith('b') ? balls[Number.parseInt(key.slice(1), 10)] : undefined;
  return { key, d, ball, lit: key.endsWith('l') };
});

/** Cycle of one ball's box; boxes take turns. */
const BOX_CYCLE = 10.8;
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(2)}%`;
---

<div class="rv">
  <div class="rv-view">
    <svg
      class="rv-img"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="none"
      shape-rendering="crispEdges"
      focusable="false"
    >
      {shapes.map(({ key, d, ball, lit }) =>
        ball ? (
          <path class:list={['rv-ball', { 'rv-ball-lit': lit }]} style={`--bh:${ball.hue}`} d={d} />
        ) : (
          <path class={key} d={d} />
        ),
      )}
    </svg>
    {balls.map(({ x, y, r }, i) => (
      <span
        class:list={['rv-box', { 'is-boxed': i === 1 || i === 3 }]}
        style={`left:${pct(x - r - 2.2, W)};top:${pct(y - r - 2.2, H)};width:${pct(2 * r + 4.4, W)};height:${pct(2 * r + 4.4, H)};--delay:${(-(i * BOX_CYCLE) / balls.length).toFixed(2)}s`}
      />
    ))}
  </div>

  <div class="rv-hud">
    <span class="rv-corner rv-tl"></span>
    <span class="rv-corner rv-tr"></span>
    <span class="rv-corner rv-bl"></span>
    <span class="rv-corner rv-br"></span>
    <span class="rv-cross"></span>
    <span class="rv-rec"></span>
  </div>
</div>
