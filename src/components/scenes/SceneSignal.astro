---
/**
 * Showcase scene: two lamps signalling each other. Lamp A sends three pulses
 * along the link, lamp B lights up when they arrive and answers, and so on.
 * Purely decorative. Positions are percentages of the stage, so the two lamps
 * sit in opposite corners on any screen shape; only transform and opacity are
 * animated.
 */
const pulses = [0, 1, 2];
---

<div class="sig">
  <svg class="sig-links" width="100%" height="100%" focusable="false">
    <line class="sig-link-wide" x1="7%" y1="78%" x2="93%" y2="20%"></line>
    <line class="sig-link-tall" x1="20%" y1="86%" x2="80%" y2="13%"></line>
  </svg>

  {(['a', 'b'] as const).map((lamp) => (
    <div class={`sig-node sig-${lamp}`}>
      <span class="sig-glow" />
      <span class="sig-ring" />
      <span class="sig-ring sig-ring-2" />
      <span class="sig-core" />
    </div>
  ))}

  {pulses.map((i) => (
    <span class="sig-dot sig-to-b" style={`--i:${i}`} />
  ))}
  {pulses.map((i) => (
    <span class="sig-dot sig-to-a" style={`--i:${i}`} />
  ))}
</div>
