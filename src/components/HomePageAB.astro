---
/**
 * TEMPORARY: the first Phase 3 home page, used only by the /design/a/ and
 * /design/b/ preview routes. The real home page is HomePage.astro. Delete this
 * file with src/pages/design/ once Direction C is approved.
 */
import placeholder from '../assets/placeholders/placeholder.svg';
import { site, linkAttrs } from '../config/site';
import { experience } from '../data/experience';
import { url, tagUrl } from '../lib/paths';
import { getProjects } from '../lib/projects';
import { TAG_LABELS, type Tag } from '../lib/tags';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';

const featured = await getProjects('featured');

const disciplines: { title: string; text: string; tags: Tag[] }[] = [
  {
    title: 'Software',
    text: "I ship backend services and middleware in C++, Java and JavaScript for self-service check-in used by around 50 airlines, and I've built compilers, cloud services and automation tools on my own time.",
    tags: ['software', 'cloud'],
  },
  {
    title: 'Electronics and embedded',
    text: "I design PCBs in KiCad, hand-solder and bring them up, and write C firmware on Zephyr RTOS for Nordic and Espressif parts. I've also written FPGA vision pipelines in Verilog.",
    tags: ['pcb', 'embedded', 'fpga'],
  },
  {
    title: 'Applied AI and vision',
    text: 'I train and deploy vision models on edge hardware, self-host open-weight LLMs and generative models, and build model-agnostic agents for engineering work.',
    tags: ['computer-vision', 'ai'],
  },
];
---

<!-- Hero -->
<section class="hero">
  <div class="container-page pt-12 pb-16 sm:pt-20 sm:pb-24">
    <p class="label" data-enter style="--i:0">
      {site.role} · {site.location}
    </p>
    <h1 class="display mt-4 max-w-[18ch] sm:mt-5" data-enter style="--i:1">
      I build the board, the firmware, the model and the software.
    </h1>

    <div class="mt-8 grid items-center gap-10 sm:mt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6">
        <p class="lead max-w-[38rem]" data-enter style="--i:2">
          Software engineer of nearly 3 years with client-facing industry experience and a hands-on
          portfolio spanning computer vision, embedded firmware and PCB design: from training and
          deploying vision models on edge hardware to building custom electronics.
        </p>
        <div class="mt-8 flex flex-wrap gap-3" data-enter style="--i:3">
          <a class="btn btn-primary" href={url('projects/')}>
            See projects
            <Icon name="arrow-right" size={16} class="icon-nudge-x" />
          </a>
          <a class="btn btn-secondary" {...linkAttrs(site.cv)}>
            {site.cv.label}
            <Icon name="download" size={16} class="icon-nudge-y" />
          </a>
        </div>
      </div>

      <div class="lg:col-span-6" data-enter style="--i:4">
        <div class="media-frame is-marked">
          <img
            src={placeholder.src}
            width={placeholder.width}
            height={placeholder.height}
            alt="[[TODO: hero photo — the assembled split keyboard on a desk, or the sorter mid-run; landscape, 2000 px wide, uncluttered background]]"
            fetchpriority="high"
            decoding="async"
          />
          <span class="placeholder-badge">placeholder</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Selected projects -->
<section class="section" aria-labelledby="projects-heading">
  <div class="container-page">
    <div class="section-head" data-reveal>
      <div>
        <span class="section-index only-b" aria-hidden="true">
          01
        </span>
        <h2 class="heading" id="projects-heading">
          Selected projects
        </h2>
      </div>
      <a class="arrow-link" href={url('projects/')}>
        All projects
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project, index) => (
        <li>
          <ProjectCard project={project} index={index} />
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- What I do -->
<section class="section border-t border-line" aria-labelledby="disciplines-heading">
  <div class="container-page">
    <div class="section-head" data-reveal>
      <div>
        <span class="section-index only-b" aria-hidden="true">
          02
        </span>
        <h2 class="heading" id="disciplines-heading">
          What I do
        </h2>
      </div>
    </div>

    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      {disciplines.map((discipline, index) => (
        <div data-reveal style={`--i:${index}`}>
          <h3 class="subheading">{discipline.title}</h3>
          <p class="mt-3 text-muted">{discipline.text}</p>
          <ul class="mt-5 flex flex-wrap gap-1.5">
            {discipline.tags.map((tag) => (
              <li>
                <a class="chip" href={tagUrl(tag)}>
                  {TAG_LABELS[tag]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Experience snapshot -->
<section class="section border-t border-line" aria-labelledby="experience-heading">
  <div class="container-page">
    <div class="section-head" data-reveal>
      <div>
        <span class="section-index only-b" aria-hidden="true">
          03
        </span>
        <h2 class="heading" id="experience-heading">
          Experience
        </h2>
      </div>
      <a class="arrow-link" href={url('about/')}>
        Full CV
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <ol class="rule-list">
      {experience.map((role, index) => (
        <li class="grid gap-x-8 gap-y-1 py-6 md:grid-cols-12" data-reveal style={`--i:${index}`}>
          <p class="label md:col-span-3 md:pt-1">{role.dates}</p>
          <div class="md:col-span-4">
            <h3 class="subheading">{role.title}</h3>
            <p class="text-muted">{role.organisation}</p>
          </div>
          <p class="mt-2 text-muted md:col-span-5 md:mt-0">{role.summary}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Contact strip -->
<section class="section border-t border-line" aria-labelledby="contact-heading">
  <div class="container-page">
    <div class="panel grid gap-8 p-6 sm:p-10 lg:grid-cols-12 lg:items-center" data-reveal>
      <div class="lg:col-span-7">
        <span class="section-index only-b" aria-hidden="true">
          04
        </span>
        <h2 class="heading" id="contact-heading">
          Get in touch
        </h2>
        <p class="lead mt-3 max-w-[36rem]">
          I'm based in London and happy to talk about the projects here or about engineering work.
          The quickest way to reach me is email.
        </p>
      </div>
      <ul class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        {site.contact.map((link) => (
          <li>
            <a class="contact-link" {...linkAttrs(link)}>
              <Icon name={link.icon} size={16} />
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
