---
/**
 * A project's tags as chips. Each is a link to the projects index filtered by
 * that tag; on the index itself the filter script handles the click in place.
 */
import { tagUrl } from '../lib/paths';
import { TAG_LABELS, type Tag } from '../lib/tags';

interface Props {
  tags: readonly Tag[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<ul class:list={['tag-list', className]} aria-label="Tags">
  {tags.map((tag) => (
    <li>
      <a class="chip" href={tagUrl(tag)} data-tag={tag}>
        {TAG_LABELS[tag]}
      </a>
    </li>
  ))}
</ul>
