---
/**
 * TEMPORARY (Phase 3): switcher between Direction C and the rejected A and B.
 * Delete this component, src/pages/design/ and the A and B tokens once
 * Direction C is approved.
 */
import type { Direction } from '../config/site';
import { url } from '../lib/paths';

interface Props {
  direction: Direction;
}
const { direction } = Astro.props;

const options: { id: Direction; label: string }[] = [
  { id: 'c', label: 'C' },
  { id: 'a', label: 'A (rejected)' },
  { id: 'b', label: 'B (rejected)' },
];
---

<nav class="preview-bar" aria-label="Design direction preview">
  {options.map((option) => (
    <a
      href={url(`design/${option.id}/`)}
      aria-current={option.id === direction ? 'page' : undefined}
    >
      {option.label}
    </a>
  ))}
</nav>
<!-- Keeps the footer clear of the fixed switcher. -->
<div class="h-16" aria-hidden="true"></div>
