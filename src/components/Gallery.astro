---
/**
 * Project gallery with a lightbox.
 *
 * Every item is a plain link to its full-size picture or its video file, so
 * the gallery works without JavaScript. src/scripts/lightbox.ts opens the
 * items in the lightbox dialog instead, stepping through this gallery's items
 * only: videos are shown in the grid as a still
 * with a play icon and play in the lightbox, from the player kept in each
 * video's template. In the project page's right column, gallery-fit.ts fits
 * the column to the text beside it, ending on a "+N more" tile.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholder from '../assets/placeholders/placeholder.svg';
import type { IconName } from '../lib/icons';
import { url } from '../lib/paths';
import Icon from './Icon.astro';
import Lightbox from './Lightbox.astro';
import MediaSlot from './MediaSlot.astro';

type Item =
  | {
      type: 'image';
      src: ImageMetadata;
      alt: string;
      caption?: string | undefined;
      todo?: string | undefined;
    }
  | {
      type: 'video';
      src: string;
      poster?: ImageMetadata | undefined;
      alt: string;
      caption?: string | undefined;
      todo?: string | undefined;
    };

interface Props {
  items: Item[];
  /** Project name, icon and hue, for the placeholder panels. */
  name: string;
  icon: IconName;
  hue: number;
  /** For more than one gallery on a page (the Experience page has one per role). */
  headingId?: string;
  headingLevel?: 2 | 3;
  class?: string;
  /** Thumbnail widths, as an `<img sizes>` value. */
  sizes?: string;
  /**
   * Include the lightbox dialog. A page with several galleries includes it
   * once, with <Lightbox />; every gallery on the page shares it.
   */
  dialog?: boolean;
}

const {
  items,
  name,
  icon,
  hue,
  headingId = 'gallery-heading',
  headingLevel = 2,
  class: className,
  sizes = '(min-width: 64rem) 18rem, (min-width: 40rem) 46vw, 92vw',
  dialog = true,
} = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
const total = items.length;

const entries = await Promise.all(
  items.map(async (item) => {
    if (item.type === 'video') return { item, full: url(item.src), isPlaceholder: false };
    const isPlaceholder = item.src.src === placeholder.src;
    const full = isPlaceholder
      ? placeholder.src
      : (await getImage({ src: item.src, width: Math.min(1600, item.src.width), format: 'webp' }))
          .src;
    return { item, full, isPlaceholder };
  }),
);
---

<section class:list={['gallery', className]} aria-labelledby={headingId} data-gallery>
  <Heading class="heading" id={headingId} data-reveal>
    Gallery
  </Heading>
  <ul class="gallery-grid" data-gallery-grid>
    {entries.map(({ item, full, isPlaceholder }, index) => {
      const kind = item.type === 'video' ? 'Video' : 'Picture';
      const label = `${kind} ${index + 1} of ${total}: ${item.caption ?? item.alt}`;
      return (
        <li data-reveal style={`--i:${index % 3}`}>
          <figure class="gallery-item">
            <a
              class="gallery-link"
              href={full}
              aria-label={label}
              data-label={label}
              data-lightbox
              data-video={item.type === 'video' ? '' : undefined}
              data-placeholder={isPlaceholder ? '' : undefined}
              data-caption={item.caption}
            >
              <MediaSlot media={item} name={name} icon={icon} hue={hue} sizes={sizes} still />
              {item.type === 'video' ? (
                <span class="gallery-play" aria-hidden="true">
                  <Icon name="play" size={20} />
                </span>
              ) : (
                <span class="gallery-zoom" aria-hidden="true">
                  <Icon name="expand" size={16} />
                </span>
              )}
            </a>
            {item.type === 'video' && (
              <template data-lightbox-player>
                <MediaSlot media={item} name={name} icon={icon} hue={hue} />
              </template>
            )}
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      );
    })}
  </ul>
</section>

{dialog && <Lightbox />}
