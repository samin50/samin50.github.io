---
/**
 * Project gallery with a lightbox.
 *
 * Each picture is a plain link to its full-size image, so the gallery works
 * without JavaScript. src/scripts/project-page.ts opens the pictures in the
 * <dialog> below instead. Videos play in place and are not part of the
 * lightbox.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholder from '../assets/placeholders/placeholder.svg';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';
import MediaSlot from './MediaSlot.astro';

type Item =
  | {
      type: 'image';
      src: ImageMetadata;
      alt: string;
      caption?: string | undefined;
      todo?: string | undefined;
    }
  | {
      type: 'video';
      src: string;
      poster?: ImageMetadata | undefined;
      alt: string;
      caption?: string | undefined;
      todo?: string | undefined;
    };

interface Props {
  items: Item[];
  /** Project name, icon and hue, for the placeholder panels. */
  name: string;
  icon: IconName;
  hue: number;
}

const { items, name, icon, hue } = Astro.props;
const sizes = '(min-width: 64rem) 22rem, (min-width: 40rem) 46vw, 92vw';

const entries = await Promise.all(
  items.map(async (item) => {
    if (item.type === 'video') return { item, full: undefined, isPlaceholder: false };
    const isPlaceholder = item.src.src === placeholder.src;
    const full = isPlaceholder
      ? placeholder.src
      : (await getImage({ src: item.src, width: Math.min(1600, item.src.width), format: 'webp' }))
          .src;
    return { item, full, isPlaceholder };
  }),
);
---

<section class="gallery" aria-labelledby="gallery-heading">
  <h2 class="heading" id="gallery-heading" data-reveal>
    Gallery
  </h2>
  <ul class="gallery-grid">
    {entries.map(({ item, full, isPlaceholder }, index) => (
      <li data-reveal style={`--i:${index % 3}`}>
        <figure class="gallery-item">
          {item.type === 'image' && full ? (
            <a
              class="gallery-link"
              href={full}
              data-lightbox
              data-placeholder={isPlaceholder ? '' : undefined}
              data-caption={item.caption}
            >
              <MediaSlot media={item} name={name} icon={icon} hue={hue} sizes={sizes} />
              <span class="gallery-zoom" aria-hidden="true">
                <Icon name="expand" size={16} />
              </span>
            </a>
          ) : (
            <MediaSlot media={item} name={name} icon={icon} hue={hue} sizes={sizes} />
          )}
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>

<dialog class="lightbox" data-lightbox-dialog aria-label="Gallery picture">
  <div class="lightbox-bar">
    <p class="label" data-lightbox-count aria-live="polite"></p>
    <button type="button" class="icon-button" data-lightbox-close aria-label="Close">
      <Icon name="x" />
    </button>
  </div>
  <div class="lightbox-stage" data-lightbox-stage></div>
  <div class="lightbox-bar">
    <button type="button" class="icon-button" data-lightbox-prev aria-label="Previous picture">
      <Icon name="arrow-left" />
    </button>
    <p class="lightbox-caption" data-lightbox-caption></p>
    <button type="button" class="icon-button" data-lightbox-next aria-label="Next picture">
      <Icon name="arrow-right" />
    </button>
  </div>
</dialog>
