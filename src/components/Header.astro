---
import { site } from '../config/site';
import { url } from '../lib/paths';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Home', href: url() },
  { label: 'Projects', href: url('projects/') },
  { label: 'Experience', href: url('experience/') },
  { label: 'About', href: url('about/') },
  { label: 'Contact', href: url('contact/') },
];

const here = Astro.url.pathname;
// "Home" is current only on the home page itself; the others also on pages beneath them.
const isCurrent = (href: string) => here === href || (href !== url() && here.startsWith(href));
---

<header class="site-header" data-header>
  <div class="container-page flex flex-wrap items-center gap-x-6 py-3">
    <a href={url()} class="site-name mr-auto min-w-0 truncate" aria-label={`${site.name}, home`}>
      {site.name}
    </a>

    <!-- On narrow screens the nav drops to its own row under the name. -->
    <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="site-nav">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>
