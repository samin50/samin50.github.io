---
import '../styles/global.css';
import '../styles/home.css';
import { site } from '../config/site';
import { url } from '../lib/paths';
import { NEW_TAB_NOTE_ID } from '../lib/links';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import bricolageUrl from '../assets/fonts/bricolage-grotesque-latin-wght.woff2?url';
import figtreeUrl from '../assets/fonts/figtree-latin-wght.woff2?url';

interface Props {
  /** Page title without the site name; omit on the home page. */
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  /** Social preview image for this page (a site path); omit for the site default. */
  ogImage?: string | undefined;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogType = 'website',
  ogImage: pageImage,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} - ${site.name}` : `${site.name} - ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = pageImage
  ? new URL(pageImage, Astro.site)
  : site.ogImage
    ? new URL(url(site.ogImage), Astro.site)
    : null;

const preloadFonts = [bricolageUrl, figtreeUrl];

// Initial browser-chrome colour: the light theme's background (`--chrome` in
// tokens.css). theme.ts keeps it in step when the theme changes.
const themeColor = '#fff0e2';
---

<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Theme, before first paint. Light is the default (set on <html> above, so it
      also applies without JavaScript); a remembered choice overrides it here,
      before any CSS is applied, so the wrong theme never flashes.
    -->
    <script is:inline>
      (function () {
        try {
          const theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          /* storage unavailable: keep the default */
        }
      })();
    </script>

    <!-- Without JavaScript the header never learns that the page has scrolled,
         so it gets its solid background from the start. -->
    <noscript>
      <style>
        .site-header {
          background: var(--bg) !important;
        }
      </style>
    </noscript>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} />
    <!-- <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} /> -->

    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div
      data-scroll-sentinel
      class="pointer-events-none absolute top-0 h-4 w-px"
      aria-hidden="true"
    ></div>
    <!-- Read out after any link that opens in a new tab (aria-describedby; src/lib/links.ts). -->
    <span id={NEW_TAB_NOTE_ID} hidden>
      Opens in a new tab
    </span>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
      import '../scripts/proximity';
    </script>
  </body>
</html>
