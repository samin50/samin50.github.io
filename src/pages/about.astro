---
/**
 * About: profile, a pointer to the Experience page, education, skills, and
 * life beyond work. Scope: docs/content-plan.md §2.4 and §5.5 (decision W-12).
 * Where the old site had wording, it is used unchanged; what is new is
 * listed in docs/review-checklist.md §8.
 */
import '../styles/projects.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { linkAttrs, site } from '../config/site';
import { contextUrl, projectUrl, url } from '../lib/paths';
import { skillGroups } from '../data/skills';

/** Skill groups from the registry (src/data/skills.ts), in category order, then "Other". */
const skills = skillGroups();

/** The old site's "Interests" (legacy Sidebar.tsx). */
const interests = ['3D Printing', 'Piano', 'DIY', 'CAD'];
const social = site.contact.filter((link) => link.icon !== 'mail');
---

<BaseLayout
  title="About"
  description="MEng Electronic and Information Engineering (Imperial), software development engineer at Amadeus; education, skills, life beyond work and CV."
>
  <div class="page-head">
    <div class="container-page">
      <Breadcrumbs current="About" />
      <h1 class="display page-title" data-enter>
        About
      </h1>
    </div>
  </div>

  <div class="container-page about">
    <!-- Profile -->
    <section class="about-profile" aria-labelledby="profile-heading">
      <MediaSlot
        class="about-photo"
        alt="[[TODO: head-and-shoulders photo of me, square crop, at least 800×800]]"
        name="Picture of me!"
        icon="user"
        hue={285}
        sizes="(min-width: 48rem) 18rem, 60vw"
        eager
      />
      <div class="about-profile-text">
        <h2 class="heading" id="profile-heading">
          {site.name}
        </h2>
        <p class="label about-location">
          <Icon name="map-pin" size={16} />
          {site.location}
        </p>
        <p class="about-lead">
          I'm a software engineer of nearly 3 years with client-facing industry experience and a
          hands-on portfolio spanning computer vision, embedded firmware and PCB design: from
          training and deploying vision models on edge hardware to building custom electronics.
        </p>
        <p>
          I have an MEng in Electronic and Information Engineering from Imperial College London. At
          Amadeus I'm the primary technical contact for around 50 airline clients on self-service
          check-in kiosks and web check-in. Outside of work I spend my time on various projects, from PCB design to CAD to firmware development.
        </p>
        <div class="about-actions">
          <a class="btn btn-primary" {...linkAttrs(site.cv)}>
            <Icon name="download" size={18} class="icon-nudge-y" />
            {site.cv.label}
          </a>
          <ul class="flex gap-2" aria-label="Profiles">
            {social.map((link) => (
              <li>
                <a class="icon-button" aria-label={link.label} {...linkAttrs(link)}>
                  <Icon name={link.icon} size={16} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Pointer to Experience (decision X-3) -->
    <aside class="about-pointer" aria-label="Experience">
      <p>My work at Amadeus and my two internships are on the Experience page.</p>
      <a class="btn btn-secondary btn-sm" href={url('experience/')}>
        Experience
        <Icon name="arrow-right" size={16} class="icon-nudge-x" />
      </a>
    </aside>

    <!-- Education -->
    <section class="about-section" aria-labelledby="education-heading">
      <h2 class="heading" id="education-heading" data-reveal>
        Education
      </h2>
      <div class="about-card" data-reveal>
        <p class="role-dates">2020 - 2024</p>
        <h3 class="timeline-title">MEng Electronic and Information Engineering</h3>
        <p class="role-org">Imperial College London</p>
        <p class="mt-3">
          Final-year project:{' '}
          <a class="text-link" href={projectUrl('machine-vision-component-sorter')}>
            Machine Vision Component Sorter
          </a>
          , awarded a First.
        </p>
      </div>
    </section>

    <!-- Skills -->
    <section class="about-section" aria-labelledby="skills-heading">
      <h2 class="heading" id="skills-heading" data-reveal>
        Skills
      </h2>
      <div class="skills-grid">
        {skills.map(({ name: group, items }, index) => (
          <div
            class:list={['about-card', { 'skills-other': group === 'Other' }]}
            data-reveal
            style={`--i:${index % 3}`}
          >
            <h3 class="subheading">{group}</h3>
            <ul class="tech-list mt-3" aria-label={group}>
              {items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Beyond work -->
    <section class="about-section" aria-labelledby="beyond-heading">
      <h2 class="heading" id="beyond-heading" data-reveal>
        Beyond work
      </h2>
      <ul class="tech-list" aria-label="Interests" data-reveal>
        {interests.map((item) => (
          <li class="chip">{item}</li>
        ))}
      </ul>

      <div class="beyond-grid">
        <div class="prose">
          <!-- legacy DIYProjects.tsx:10, first sentence -->
          <p>I have always been fascinated by the idea of physically making things with my own hands, and 3D printing opened the door to a whole new world of possibilities. This, coupled with my programming and PCB design skills, means I can bring any idea of mine to life.
          </p>
          <p>
            <a class="btn btn-secondary btn-sm" href={contextUrl('personal')}>
              Personal projects
              <Icon name="arrow-right" size={16} class="icon-nudge-x" />
            </a>
          </p>

          <h3>Piano</h3>
          <!-- legacy Piano.tsx:10-13, unchanged -->
          <p>
            I have been playing piano on and off since I was around 13, but I have never had any
            formal training; after begging my parents for a keyboard, I taught myself how to play. I
            have always been interested in music, and to this day I do not consider myself a good
            pianist, but I do enjoy playing. I hope you enjoy some of my recordings!
          </p>
        </div>
        <figure class="beyond-video">
          <!-- <MediaSlot
            media={{
              type: 'video',
              src: 'sampleVideo.mp4',
              alt: 'A piano recording',
              todo: 'A short piano recording, 60 s or less, re-encoded from the old Call of Silence or 0sk clip',
            }}
            name="Piano"
            icon="piano"
            hue={325}
          />
          <figcaption>[[TODO: title of the piece]]</figcaption> -->
        </figure>
      </div>

      <div class="prose about-setup">
        <h3>My setup</h3>
        <!-- legacy Hero.tsx:22-25, unchanged (decision C-4) -->
        <p>
          My current setup is a Legion 9 82F5 with an RTX 5090, which I use for work, gaming and AI; the 24 GB of VRAM has proven very useful for this"
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
