---
/**
 * Projects index: every university and personal project, with two filters
 * that combine: context (University / Personal) and tag.
 *
 * Everything is in the HTML. Without JavaScript the filter chips are links to
 * `?context=…` and `?tag=…` and the page shows all projects;
 * src/scripts/project-filter.ts filters in place.
 */
import '../../styles/projects.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveCard from '../../components/ArchiveCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getPageProjects, getProjects } from '../../lib/projects';
import { contextUrl, tagUrl, url } from '../../lib/paths';
import { CONTEXTS, CONTEXT_LABELS, TAGS, TAG_LABELS } from '../../lib/tags';

const cards = await getPageProjects();
const archive = await getProjects('archive');
const all = [...cards, ...archive];

const contexts = CONTEXTS.map((context) => ({
  value: context,
  label: CONTEXT_LABELS[context],
  href: contextUrl(context),
  count: all.filter(({ data }) => data.context === context).length,
}));
// Only tags that at least one project carries become chips.
const tags = TAGS.map((tag) => ({
  value: tag,
  label: TAG_LABELS[tag],
  href: tagUrl(tag),
  count: all.filter(({ data }) => data.tags.includes(tag)).length,
})).filter(({ count }) => count > 0);

const groups = [
  { key: 'context', label: 'Context', options: contexts },
  { key: 'tag', label: 'Tag', options: tags },
];
const plural = (count: number) => (count === 1 ? 'project' : 'projects');
---

<BaseLayout
  title="Projects"
  description="University and personal projects in hardware, firmware, software and AI: a wireless split keyboard, a vision-based component sorter, an FPGA rover and more."
>
  <div class="page-head">
    <div class="container-page">
      <Breadcrumbs current="Projects" />
      <h1 class="display page-title" data-enter>
        Projects
      </h1>
      <!-- Owner's wording from the old site (legacy ProgProjects.tsx). -->
      <p class="page-intro" data-enter style="--i:1">
        I have worked on many projects, some of which I will showcase here.
      </p>

      <div class="filter-bar" data-filter-bar data-enter style="--i:2">
        {groups.map(({ key, label, options }) => (
          <nav class="filter-group" aria-label={`Filter projects by ${label.toLowerCase()}`}>
            <span class="filter-label" aria-hidden="true">
              {label}
            </span>
            <ul class="filter-list">
              <li>
                <a
                  class="chip filter-chip is-active"
                  href={url('projects/')}
                  data-filter={key}
                  data-value=""
                >
                  All
                  <span class="chip-count" aria-hidden="true" data-count>
                    {all.length}
                  </span>
                  <span class="sr-only">
                    , <span data-count>{all.length}</span> projects
                  </span>
                </a>
              </li>
              {options.map((option) => (
                <li>
                  <a
                    class="chip filter-chip"
                    href={option.href}
                    data-filter={key}
                    data-value={option.value}
                  >
                    {option.label}
                    <span class="chip-count" aria-hidden="true" data-count>
                      {option.count}
                    </span>
                    <span class="sr-only">
                      , <span data-count>{option.count}</span> {plural(option.count)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
    </div>
  </div>

  <div class="section-tight" data-filter-group>
    <div class="container-page">
      <div class="card-grid">
        {cards.map((project, index) => (
          <ProjectCard project={project} index={index} eager={index < 3} />
        ))}
      </div>
    </div>
  </div>

  <section class="section-tight" aria-labelledby="archive-heading" data-filter-group>
    <div class="container-page">
      <h2 class="heading" id="archive-heading" data-reveal>
        More projects
      </h2>
      <div class="archive-grid">
        {archive.map((project, index) => (
          <ArchiveCard project={project} index={index} />
        ))}
      </div>
    </div>
  </section>

  <!-- Shown by the filter script when the two filters together match nothing. -->
  <div class="container-page" data-filter-empty hidden>
    <p class="filter-empty">No projects match both filters.</p>
  </div>
</BaseLayout>

<script>
  import '../../scripts/project-filter';
</script>
